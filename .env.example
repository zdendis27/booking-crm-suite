# Zkopíruj do apps/web/.env.local a doplň hodnoty. Tento soubor neobsahuje žádná tajemství.

# Brand (pracovní název; rebrand = změna zde, ne v kódu)
NEXT_PUBLIC_BRAND_NAME=Terminio
NEXT_PUBLIC_BASE_DOMAIN=localhost:3000

# Supabase (dev projekt v cloudu)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Pouze server! Nikdy s prefixem NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# E-mail (Resend) – krok 6
RESEND_API_KEY=

# Web push (VAPID) – krok 6
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
